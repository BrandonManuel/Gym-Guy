[sub_resource type="Shader" id="Shader_sqwnb"]
code = "shader_type canvas_item;

uniform bool current = false;
uniform bool correct = false;
uniform vec4 current_color : source_color = vec4(1, 1, 1, 1);
uniform vec4 correct_color : source_color = vec4(0, 1, 0, 1);
uniform float outline_size = 1.0;

void fragment() {
	vec4 color = texture(TEXTURE, UV);
	
	float frame_height = 1.0 / 26.0;
	float frame_top = floor(UV.y / frame_height) * frame_height;
	float frame_bottom = frame_top + frame_height;
	
	if (correct) {
		vec2 size = vec2(0.05, 0.05 / 26.0);
		float alpha = 0.0;
		vec2 offsets[8] = {
			vec2(size.x, 0), vec2(-size.x, 0),
			vec2(0, size.y), vec2(0, -size.y),
			vec2(size.x, size.y), vec2(-size.x, size.y),
			vec2(size.x, -size.y), vec2(-size.x, -size.y)
		};
		for (int i = 0; i < 8; i++) {
			vec2 sample_uv = UV + offsets[i];
			sample_uv.y = clamp(sample_uv.y, frame_top, frame_bottom);
			alpha += texture(TEXTURE, sample_uv).a;
		}
		if (color.a < 0.5 && alpha > 0.0) {
			color = correct_color;
		}
	}
	COLOR = color;
}
"

